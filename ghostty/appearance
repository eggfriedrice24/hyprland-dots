# Theme and window chrome
# generated theme lives in the eggfriedrice.nvim repo (`make extras`); themes/eggfriedrice links to it
theme = eggfriedrice
# matches the Thunar panel (gtk-3.0/thunar.css, alpha 0.86) so terminals and the file manager read as one surface
background-opacity = 0.86

# old-school blinking block cursor everywhere
cursor-style = block
cursor-style-blink = true

# no size popup while hyprland retiles
resize-overlay = never

# tabs: full-width (flex-like), flat bar, eggfriedrice colors via custom css
gtk-wide-tabs = true
gtk-toolbar-style = flat
window-theme = ghostty
# window-titlebar-background and -foreground are provided by the theme (bg_dark, fg)
gtk-custom-css = gtk.css
