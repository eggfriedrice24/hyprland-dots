# Theme and window chrome
# generated theme lives in the eggfriedrice.nvim repo (`make extras`); themes/eggfriedrice links to it
theme = eggfriedrice
background-opacity = 0.75

# old-school blinking block cursor everywhere
cursor-style = block
cursor-style-blink = true

# no size popup while hyprland retiles
resize-overlay = never

# tabs: full-width (flex-like), flat bar, eggfriedrice colors via custom css
gtk-wide-tabs = true
gtk-toolbar-style = flat
window-theme = ghostty
# window-titlebar-background is provided by the theme (bg_dark)
# titlebar text mirrors palette fg, overriding the theme's fg_dark
window-titlebar-foreground = #d8d3c3
gtk-custom-css = gtk.css
