# Keybinds - ghostty defaults kept (ctrl+shift+t tabs, ctrl+shift+o/e splits,
# ctrl+shift+f search, ctrl+shift+p palette); additions below

keybind = ctrl+shift+u=copy_url_to_clipboard

# browser-like tabs (note: shadows zsh ctrl+w word-delete and fzf ctrl+t)
keybind = ctrl+t=new_tab
keybind = ctrl+w=close_tab:this

# physical-key duplicates so core binds keep working on the Georgian layout
# (codepoint triggers stop matching once the key produces a Georgian letter)
keybind = ctrl+shift+key_c=copy_to_clipboard:mixed
keybind = ctrl+shift+key_v=paste_from_clipboard
keybind = ctrl+shift+key_f=start_search
keybind = ctrl+shift+key_p=toggle_command_palette
keybind = ctrl+shift+key_u=copy_url_to_clipboard
keybind = ctrl+key_t=new_tab
keybind = ctrl+key_w=close_tab:this
