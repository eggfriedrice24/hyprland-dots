# One process per window: a crash takes down a single terminal, and new
# windows honor working-directory instead of the focused window's cwd
gtk-single-instance = false
window-inherit-working-directory = false
working-directory = home

# desktop notification when a command running >=15s finishes unfocused
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 15s

# ssh: fall back TERM on remote hosts, offer terminfo install.
# no-cursor: keep the block cursor at the prompt instead of the bar the
# shell integration would switch to
shell-integration-features = ssh-env,ssh-terminfo,no-cursor

# io_uring waits count as iowait, pinning IO PSI near 100% while idle
# (libxev#216); epoll until libxev passes IORING_ENTER_NO_IOWAIT
async-backend = epoll
