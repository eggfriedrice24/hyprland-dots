# dunst - styled with the eggfriedrice palette

[global]
    ### Geometry
    origin = top-right
    offset = (12, 12)
    width = (240, 380)
    height = (0, 280)
    gap_size = 6
    padding = 12
    horizontal_padding = 14
    notification_limit = 4

    ### Look
    font = Cartograph CF 10.5
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_indicators = false
    corner_radius = 3
    frame_width = 1
    separator_height = 1
    separator_color = frame

    ### Icons
    icon_position = left
    min_icon_size = 16
    max_icon_size = 40
    enable_recursive_icon_lookup = true

    ### Progress bar (volume / brightness)
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 2
    highlight = "#ffc940"

    ### Behavior
    idle_threshold = 2m
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#0d111af2"
    foreground = "#8695b7"
    frame_color = "#2f3b54"
    timeout = 5

[urgency_normal]
    background = "#0d111af2"
    foreground = "#d8d3c3"
    frame_color = "#2f3b54"
    timeout = 8

[urgency_critical]
    background = "#0d111af2"
    foreground = "#d8d3c3"
    frame_color = "#eb5757"
    highlight = "#eb5757"
    timeout = 0
