# dunst - colours come from the eggfriedrice drop-in in dunstrc.d/

[global]
    ### Geometry
    follow = mouse
    origin = top-right
    offset = (12, 12)
    width = (240, 380)
    height = (0, 280)
    gap_size = 6
    padding = 12
    horizontal_padding = 14
    notification_limit = 4

    ### Look
    font = Cartograph CF 10.5
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_indicators = false
    corner_radius = 3
    frame_width = 1
    separator_height = 1

    ### Icons
    icon_position = left
    min_icon_size = 16
    max_icon_size = 40
    enable_recursive_icon_lookup = true

    ### Progress bar (volume / brightness)
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 2

    ### Behavior
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    timeout = 5

[urgency_normal]
    timeout = 8

[urgency_critical]
    timeout = 0
