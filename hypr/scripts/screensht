#!/usr/bin/env bash
# Screenshot with grimblast: saved to ~/Pictures/Screenshots and copied to the clipboard
# Usage: screensht full | area

set -o pipefail

SCREENSHOT_DIR="$HOME/Pictures/Screenshots"

notify_fail() {
    dunstify -u critical -t 3000 -a "Screenshot Tool" "Screenshot failed" "$1"
    exit 1
}

main() {
    local mode="$1" message="$2"
    mkdir -p "$SCREENSHOT_DIR"

    local target="$SCREENSHOT_DIR/$(date +%s).png"
    if ! grimblast copysave "$mode" "$target" >/dev/null 2>&1; then
        notify_fail "grimblast copysave $mode"
    fi

    dunstify -i "$target" -t 10000 -a "Screenshot Tool" "Screenshot Tool" "$message"
}

case "${1:-}" in
    full) main output "Full screenshot saved and copied to clipboard" ;;
    area) main area "Area screenshot saved and copied to clipboard" ;;
    *)
        echo "Usage: screensht full | area"
        exit 1
        ;;
esac
