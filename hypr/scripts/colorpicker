#!/usr/bin/env bash
# Pick a colour with hyprpicker (copied to the clipboard by -a) and show it as a swatch notification

set -euo pipefail

for dep in hyprpicker magick notify-send; do
    if ! command -v "$dep" &>/dev/null; then
        notify-send -u critical -a "Color Picker" "Color Picker" "$dep is not installed"
        exit 1
    fi
done

color="$(hyprpicker -a -n)"
[[ -n "$color" ]] || exit 0

swatch="${XDG_RUNTIME_DIR:-/tmp}/colorpicker_${color#\#}.png"
magick -size 120x120 "xc:$color" "$swatch"
notify-send -a "Color Picker" -i "$swatch" "Color picked" "$color"
