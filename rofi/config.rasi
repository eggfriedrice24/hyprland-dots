@import "eggfriedrice.rasi"

configuration {
    modi: "drun";
    show-icons: true;
    // second line is the desktop entry's Comment, dimmed with pango alpha so it follows the row's text colour
    drun-display-format: "{name}\n<span size='small' alpha='60%'>{comment}</span>";
    // two text lines per row so the comment line is not clipped
    eh: 2;
    matching: "fuzzy";
    sort: true;
    sidebar-mode: false;
    icon-theme: "hicolor";
    kb-row-left: "Left,Control+Page_Up";
    kb-row-right: "Right,Control+Page_Down";
    kb-move-char-back: "Control+b";
    kb-move-char-forward: "Control+f";
}

// colours are the launcher roles of the imported palette (@panel, @panel-edge, @panel-divider,
// @muted, @accent, @on-accent, ...); @panel must stay above the rofi layer rule's ignore_alpha (0.20)
// for the hyprland blur to show through. rofi/global/emoji.rasi imports this file and overrides the list.
// fonts are the palette file's typography properties (@font-ui-sm, @font-ui-md, @font-icon, ...)
* {
    background-color: transparent;
    text-color: @foreground;
    font: @font-ui-sm;
}

// anchored from the top so the search bar stays put while results grow downward
window {
    transparency: "real";
    location: north;
    anchor: north;
    y-offset: 24%;
    width: 600px;
    border: 1px;
    border-color: @panel-edge;
    border-radius: 12px;
    background-color: @panel;
}

mainbox {
    padding: 0px;
    spacing: 0px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 12px 16px;
    spacing: 10px;
    children: [ textbox-search, entry ];
}

// custom textbox, since prompt always prints the mode name; nf-fa-search, the ui font has no nerd glyphs
textbox-search {
    str: "";
    expand: false;
    font: @font-icon;
    text-color: @muted;
    vertical-align: 0.5;
}

entry {
    placeholder: "Search";
    placeholder-color: @muted;
    font: @font-ui-md;
    text-color: @input;
    cursor: text;
    vertical-align: 0.5;
}

// require-input hides the whole widget until you type, divider included
listview {
    columns: 1;
    lines: 7;
    layout: vertical;
    padding: 6px;
    spacing: 1px;
    border: 1px 0px 0px 0px;
    border-color: @panel-divider;
    fixed-height: false;
    require-input: true;
    dynamic: true;
    cycle: true;
    scrollbar: false;
}

element {
    padding: 6px 10px;
    spacing: 10px;
    border-radius: 8px;
    children: [ element-icon, element-text ];
    cursor: pointer;
}

element-icon {
    size: 26px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    cursor: inherit;
}

element normal.normal,
element normal.active,
element alternate.normal,
element alternate.active {
    background-color: transparent;
    text-color: @foreground;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color: @urgent;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @accent;
    text-color: @on-accent;
}

message {
    padding: 10px 18px;
    border: 1px 0px 0px 0px;
    border-color: @panel-divider;
}

textbox {
    text-color: @muted;
}
