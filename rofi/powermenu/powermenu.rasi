@import "/home/eggfriedrice/p/eggfriedrice.nvim/extras/rofi/eggfriedrice.rasi"

configuration {
	font: "JetBrainsMono Nerd Font 36";
	drun-display-format: "{name}";
	fullscreen: false;
	threads: 0;
	matching: "fuzzy";
	scroll-method: 0;
	disable-history: false;
	fullscreen: true;
}

* {
	// translucent values keep the original alpha on the palette hex; rasi has no alpha()
	transparent: #00000000;
	foreground: #f2edddee; // @fg-bright
	background-selected: #f2eddd45; // @fg-bright
	background-active: #f2eddd30; // @fg-bright
	background-white: #f2eddd11; // @fg-bright
	background-black: #090c1366; // @bg-dark
	urgent: #e06c7566; // @red
	urgent-selected: #e06c7577; // @red
}

window {
	transparency: "real";
	background-color: @transparent;
	text-color: @foreground;
	location: northwest;
	anchor: northwest;
}

inputbar {
	margin: 0;
	padding: 0;
	children: [ entry-wrapper ];
}

listview {
	background-color: @transparent;
	lines: 6;
	spacing: 5%;
	cycle: false;
	dynamic: true;
	layout: horizontal;
}

mainbox {
	background-color: @background-black;
	children: [ inputbar, listview ];
    padding: calc(50% - 70px) 0% 0% 15%;
}

element {
	background-color: @transparent;
	text-color: @foreground;
	orientation: horizontal;
	border-radius: 10px;
    padding: 30px;
    vertical: 0.5;
}

element-text {
	expand: true;
	horizontal-align: 0.5;
	vertical-align: 0.5;
}

element normal.urgent,
element alternate.urgent {
	background-color: @urgent;
	text-color: @foreground;
	border-radius: 9px;
}

element normal.active,
element alternate.active {
	background-color: @background-active;
	text-color: @foreground;
}

element selected {
	background-color: @yellow;
	text-color: @bg;
}

element selected.urgent {
	background-color: @urgent-selected;
	text-color: @foreground;
}

element selected.active {
	background-color: @background-active;
	color: @foreground-selected;
}
