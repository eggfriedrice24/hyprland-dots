// the launcher's panel, search bar and colours for rofi-calc: the live result sits in the message
// box under the search bar. The keybind runs it with -no-history, which leaves one blank row that
// Enter acts on, so the list is dropped from the layout; Enter still accepts it.
@import "../config.rasi"

configuration {
    show-icons: false;
}

mainbox {
    children: [ inputbar, message ];
}

// nf-fa-calculator
textbox-search {
    str: "";
}

entry {
    placeholder: "Calculate";
}

message {
    padding: 10px 16px 12px 16px;
}

textbox {
    font: "Cartograph CF 15";
    text-color: @input;
}
