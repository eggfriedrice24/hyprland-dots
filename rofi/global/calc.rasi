// the launcher's panel, search bar and colours for rofi-calc: the live result sits in the message
// box under the search bar and saved results list below it
@import "../config.rasi"

configuration {
    // one line per history row; the launcher's eh: 2 is for its name + comment rows
    eh: 1;
    show-icons: false;
}

mainbox {
    children: [ inputbar, message, listview ];
}

// nf-fa-calculator
textbox-search {
    str: "";
}

entry {
    placeholder: "Calculate";
}

message {
    padding: 10px 16px 12px 16px;
}

textbox {
    font: "Cartograph CF 15";
    text-color: @input;
}

// history: always shown, newest first, the divider above it only when there is any
listview {
    lines: 5;
    require-input: false;
}

element {
    padding: 6px 10px;
    children: [ element-text ];
}
