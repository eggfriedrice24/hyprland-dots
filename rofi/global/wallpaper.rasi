// wallpaper picker (hypr/scripts/wallpaper-picker, SUPER+SHIFT+W): the launcher's panel and colours,
// nothing but a grid of square thumbnails. No search bar; typing still filters by name
@import "../config.rasi"

configuration {
    show-icons: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

window {
    location: center;
    anchor: center;
    y-offset: 0;
    width: 900px;
}

mainbox {
    children: [ listview ];
}

// all of them at once, at a fixed size, so the window never resizes
listview {
    columns: 4;
    lines: 2;
    padding: 12px;
    spacing: 12px;
    border: 0px;
    fixed-height: true;
    fixed-columns: true;
    require-input: false;
    dynamic: false;
}

element {
    padding: 4px;
    border: 2px;
    border-color: transparent;
    border-radius: 12px;
    children: [ element-icon ];
}

element-icon {
    size: 196px;
    border-radius: 8px;
    horizontal-align: 0.5;
}

// no fill, so the photo keeps its colours: the tile is marked by the accent edge alone
element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active,
element selected.normal,
element selected.active,
element selected.urgent {
    background-color: transparent;
}

element selected.normal,
element selected.active,
element selected.urgent {
    border-color: @accent;
}

// the wallpaper on screen now
element normal.active,
element alternate.active {
    border-color: @panel-edge;
}
