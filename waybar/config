{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock",
    "clock#date"
  ],
  "modules-right": [
    "tray",
    "cpu",
    "temperature",
    "memory",
    "custom/separator#left",
    "pulseaudio",
    "network",
    "battery",
    "battery#bat1"
  ],
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "sort-by-number": true,
    "active-only": true,
    "all-outputs": false
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 40,
    "separate-outputs": true,
    "rewrite": {
      "(.*) - nvim": " $1",
      "[Gg]hostty": "󰊠 ghostty"
    }
  },
  "clock": {
    "_comment": "time and date are two modules so style.css can colour the date from the palette; Pango markup cannot reference the GTK css names, so today in the calendar is marked by weight and underline instead of a colour",
    "format": "{:%H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<b><u>{}</u></b>"
      }
    }
  },
  "clock#date": {
    "format": "· {:%a, %b %d}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<b><u>{}</u></b>"
      }
    }
  },
  "cpu": {
    "interval": 2,
    "format": "󰍛 {usage}%",
    "tooltip": true,
    "on-click": "ghostty -e btop"
  },
  "memory": {
    "interval": 2,
    "format": "󰘚 {percentage}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G used",
    "on-click": "ghostty -e btop"
  },
  "temperature": {
    "_comment": "first existing path wins: k10temp on the AMD desktop, coretemp on an Intel laptop",
    "hwmon-path-abs": [
      "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
      "/sys/devices/platform/coretemp.0/hwmon"
    ],
    "input-filename": "temp1_input",
    "critical-threshold": 90,
    "format": "󰔏 {temperatureC}°C",
    "format-critical": "󰔏 {temperatureC}°C",
    "tooltip-format": "CPU Temp: {temperatureC}°C"
  },
  "network": {
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀 Wired",
    "format-disconnected": "󰖪 Disconnected",
    "tooltip-format-wifi": "{signalStrength}% | {ipaddr}",
    "on-click": "ghostty -e nmtui"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+",
    "on-scroll-down": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%-"
  },
  "battery": {
    "bat": "BAT0",
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁾",
      "󰂁",
      "󰁹"
    ]
  },
  "battery#bat1": {
    "_comment": "same block pinned to BAT1 for laptops whose battery is not BAT0; each module hides when its battery is absent, and the pins keep the bluetooth keyboard's battery (whose removal crashed waybar) out of both",
    "bat": "BAT1",
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁾",
      "󰂁",
      "󰁹"
    ]
  },
  "custom/separator#left": {
    "format": "|",
    "interval": "once",
    "tooltip": false
  },
  "tray": {
    "icon-size": 16,
    "spacing": 12
  }
}
